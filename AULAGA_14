import re
def recuperar_numeros_palabra(fcihero_entrada, fichero_salida):
    with open(fichero_entrada, "r") as f_in, open(fichero_salida, "w") as f_out:
        pattern = r"[a-zA-Z]+\d\S*|\S*\d[a-zA-Z]+"
        contador = 0
        for linea in f_in:
            palabras = re.findall(pattern, linea)
            if palabras:
                for palabra in palabras:
                    f_out.write(f"{palabra:>20}\n")
                    contador += 1
        f_out.write(f"Total encontrado:{contador}")



if __name__ == "__main__":
    fichero_entrada = "texto.txt"
    fichero_salida = "salida_numeros.txt"

    recuperar_numeros_palabra(fichero_entrada, fichero_salida)

    print("Proceso terminado.")
    print("Revisa el fichero:", fichero_salida)
    
def leer_fichero(nombre_fichero):
    with open(nombre_fichero, "r") as f:
        for linea in f:
            print(linea, end="")
            
leer_fichero("salida_numeros.txt")
