import re
def filtrar_frases(fichero_entrada, fichero_salida, palabras_prohibidas):
    with open(fichero_entrada, "r") as f_in, open(fichero_salida, "w") as f_out:
        pattern = r"\b(niñ(o|a|os|as)|cas(a|as)|hombr(e|es))\b"
        for linea in f_in:
            palabras_prohibidas = re.findall(pattern, linea)
            if not palabras_prohibidas:
                f_out.write(f"{linea}")
                
        

