def agrupar_por_pais(fichero_entrada, fichero_salida):
    with open(fichero_entrada, "r") as f_in, open(fichero_salida, "w") as f_out:
        datos = {}
        for linea in f_in:
            palabras = linea.strip().split(";")
            ciudad = palabras[0]
            nombre = palabras[1]
            if ciudad not in datos:
                datos[ciudad] = []
            datos[ciudad].append(nombre)
            
        for ciudad in datos:    
            f_out.write(f"{ciudad}: ")
            for nombre in ciudad:
                f_out.write(f"{nombre}")
if __name__ == "__main__":

    fichero_entrada = "ciudades.txt"
    fichero_salida = "paises.txt"

    agrupar_por_pais(fichero_entrada, fichero_salida)

    print("Fin del programa")
    
def leer_fichero(nombre_fichero):
    f = open(nombre_fichero, "r", encoding="utf-8")

    for linea in f:
        print(linea.strip())

    f.close()
    
if __name__ == "__main__":

    fichero = "paises.txt"
    leer_fichero(fichero)

    print("Fin del programa")
