def generar_factura(fichero_entrada, fichero_salida, productos):
    with open(fichero_entrada, "r") as f_in, open(fichero_salida, "w") as f_out:
        suma = 0
        for linea in f_in:
            produccion = linea.strip().split(":")
            codigo = produccion[0].strip()
            nombre = produccion[1].strip()
            cantidad = produccion[2].strip()
            new_cantidad = int(cantidad)
            precios = productos[codigo]
            total = new_cantidad * precios
            suma += total
            f_out.write(f"{codigo:<7}|{nombre:<30}|{cantidad:<5}|{precios:<10}|{total:<8}")
        f_out.write(f"Importe total:{suma}")
        
        
