def leer_calificaciones(fichero):
    dic = {}
    with open(fichero, "r") as f_in:
        for linea in f_in:
            palabras = linea.strip().split(":")
            if palabras[0] not in dic:
                dic[palabras[0]] = []
                dic[palabras[0]] = (palabras[1], palabras[2])
    return dic
    



           
